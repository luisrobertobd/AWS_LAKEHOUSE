{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListarDatosLaboratorio",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": "arn:aws:s3:::lablake"
        },
        {
            "Sid": "LeerLanding",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::lablake/landing/*"
        },
        {
            "Sid": "LeerEscribirBronze",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::lablake/bronze/*"
        }
    ]
}